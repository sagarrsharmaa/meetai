# ---------- Database (Neon / any Postgres) ----------
DATABASE_URL=

# ---------- Better Auth ----------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Stream Video (getstream.io) ----------
# Required for calls, transcripts, recordings and the webhook.
NEXT_PUBLIC_STREAM_VIDEO_API_KEY=
STREAM_VIDEO_SECRET_KEY=

# ---------- Stream Chat ----------
# Required for the "Ask AI" tab on completed meetings.
NEXT_PUBLIC_STREAM_CHAT_API_KEY=
STREAM_CHAT_SECRET_KEY=

# ---------- OpenAI ----------
# Powers the in-call realtime agent, the summary job and the post-meeting chat.
OPENAI_API_KEY=

# ---------- Polar (billing, optional) ----------
# Leave empty to run without billing: free-tier limits are then not enforced.
POLAR_ACCESS_TOKEN=
# "sandbox" (default) or "production"
POLAR_SERVER=sandbox

# ---------- Inngest ----------
# Not needed locally (run `npx inngest-cli@latest dev` instead).
# Required only when deploying:
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
